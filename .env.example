# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# Trigger.dev — cloud.trigger.dev -> your project -> API Keys (dev secret key)
TRIGGER_SECRET_KEY=

# News workflow topic (news-linkedin-infographic)
NEWS_NICHE=

# Research workflow topic (research-linkedin-post) — separate on purpose,
# independent from NEWS_NICHE even if you set them to the same value.
RESEARCH_NICHE=

# Tavily API key — get one at https://app.tavily.com (free tier: 1,000 searches/month)
TAVILY_API_KEY=

# LinkedIn — same app/credentials used by .claude/skills/social-post.
# Full setup instructions: .claude/skills/social-post/platforms/linkedin.md
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_AUTHOR_URN=
